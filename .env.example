# إعدادات مفاتيح API لمشروع منصة الذكاء الاصطناعي لكواشف المعادن
# قم بنسخ هذا الملف إلى .env وضع مفاتيحك الخاصة

# مفتاح Google Gemini API (مطلوب لتشغيل الوكلاء)
# احصل عليه من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_KEY_HERE"

# مفتاح Tavily Search API (اختياري للبحث التلقائي عن براءات الاختراع)
# احصل عليه من: https://tavily.com
TAVILY_API_KEY="tvly-YOUR_TAVILY_KEY_HERE"
